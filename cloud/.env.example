# Copy to cloud/.env (not committed). Same user as in mosquitto/passwd.
MQTT_USER=sagriot
MQTT_PASSWORD=change-me
# Optional per-node settings (field capacity, cycle length), see service.py:
# NODES_FILE=/app/nodes.json
# Telegram bot (@BotFather -> /newbot). Never commit the real token.
TELEGRAM_TOKEN=
# Optional: fixed chat; otherwise the first chat that sends /start is used
# TELEGRAM_CHAT_ID=
