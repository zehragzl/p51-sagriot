# Copy to sdkconfig.local (not committed) and fill in.
# After changing it, delete firmware/sdkconfig so the new values are read.
CONFIG_SAGRIOT_WIFI_SSID="wifi-name"
CONFIG_SAGRIOT_WIFI_PASSWORD="wifi-password"
CONFIG_SAGRIOT_MQTT_URI="mqtt://192.168.1.10:1883"
CONFIG_SAGRIOT_NODE_ID="node01"
CONFIG_SAGRIOT_MODE_EDGE=y
# for cloud mode use this line instead of the one above:
# CONFIG_SAGRIOT_MODE_CLOUD=y
CONFIG_SAGRIOT_PERIOD_MS=2000
